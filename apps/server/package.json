  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "prisma": "^7.8.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.2"
  }

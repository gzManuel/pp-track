{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev --config=./prisma/prisma.config.ts --schema=./prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --config=./prisma/prisma.config.ts --schema=./prisma/schema.prisma",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@repo/api-contract": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "yahoo-finance2": "^3.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}

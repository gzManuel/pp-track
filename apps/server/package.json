{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev --config=./prisma/prisma.config.ts --schema=./prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --config=./prisma/prisma.config.ts --schema=./prisma/schema.prisma",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "import-portfolio": "tsx scripts/import-portfolio.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "yahoo-finance2": "^3.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "prisma": "^7.8.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.1.10"
  }
}

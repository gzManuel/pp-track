# PostgreSQL connection string (driver-adapter mode via @prisma/adapter-pg)
DATABASE_URL="postgresql://user:password@localhost:5432/pp_track_dev"

# Shared secret used to authenticate requests coming from the web app.
# Must match INTERNAL_API_SECRET in apps/web/.env.local
INTERNAL_API_SECRET="change-me-to-a-long-random-string"

# Optional — server defaults to these if unset
# PORT=3001
# HOST=0.0.0.0
# LOG_LEVEL=info   # fatal | error | warn | info | debug | trace

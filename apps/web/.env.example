# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-run-openssl-rand-base64-32"

# Google OAuth credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth credentials (https://developers.facebook.com/)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Base URL of the Fastify API server
SERVER_API_URL="http://localhost:3001"

# Shared secret for server requests — must match INTERNAL_API_SECRET in apps/server/.env
INTERNAL_API_SECRET="change-me-to-a-long-random-string"

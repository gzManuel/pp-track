{
  "name": "pp-track",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "migrate": "pnpm --filter server run migrate",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,md,json,css}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9"
  }
}
